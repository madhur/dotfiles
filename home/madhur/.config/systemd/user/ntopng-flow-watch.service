[Unit]
Description=Alert on large individual network flows (ntopng flow dump)
# No After=/Requires= on ntopng@enp5s0.service or systemd-journald@ntopng-flows.service
# here: those are system units and a user manager can't order against a
# different manager's units. Restart=always covers the boot race instead -
# if the namespace isn't up yet, journalctl exits and we just retry.
After=network.target

[Service]
Type=simple
ExecStart=%h/scripts/ntopng-flow-watch
Environment=FLOWWATCH_THRESHOLD_MB=250
Environment=FLOWWATCH_ROUTER_IP=192.168.1.82
Environment=FLOWWATCH_NTFY_URL=http://172.22.0.24/monitoring
Environment=FLOWWATCH_HISTORY_FILE=%h/scripts/ntopng-flow-report/flowwatch_history.json
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
