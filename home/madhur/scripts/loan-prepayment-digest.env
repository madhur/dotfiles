# Weekly SBI loan prepayment digest config (loaded by loan_prepayment_digest.py).
# All keys are optional; defaults below match the committed values.

MAIL_FROM=loan-digest@madhur.co.in
MAIL_TO=ahuja.madhur@gmail.com

# Same env file the SMS/ICICI/Firefly-digest scripts use for FIREFLY_BASE_URL / FIREFLY_PAT.
FIREFLY_ENV_FILE=/home/madhur/Desktop/python/.env

# Substring match (case-insensitive) against Firefly asset account names.
LOAN_ACCOUNT_MATCH=SBI Loan

# Current annual interest rate (%). This loan is floating/EBLR-linked — bump
# this by hand whenever SBI resets it; the script has no way to detect a
# reset automatically.
CURRENT_RATE=7.5

# EMI held fixed (SBI's reduce-tenure default behavior for this loan).
EMI=136951

# Original loan terms, from the Key Fact Statement — used only to infer this
# week's prepayment pace (current balance vs. what it would be with zero
# prepayment). Change only if the loan itself is refinanced/restructured.
ORIGINAL_PRINCIPAL=17000000
ORIGINAL_RATE=7.5
ORIGINAL_MONTHS=240
ORIGINAL_START=05/04/2026

# ntfy delivery. Deliberately NOT named NTFY_TOPIC: run_with_notification
# (the every_week.sh wrapper) exports NTFY_TOPIC=<its own topic> into this
# script's environment, which would silently override a same-named var.
LOAN_NTFY_TOPIC=transactions
NTFY_SERVER=https://ntfy.madhur.co.in
